<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/questionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:id="@+id/rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/rateBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:max="100" />
</LinearLayout>
